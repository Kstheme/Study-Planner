# =============================================================================
# 数据库配置
# =============================================================================
DATABASE_URL=
TEST_DATABASE_URL=

# =============================================================================
# Milvus 向量数据库配置
# 用于存储和检索学习材料的向量嵌入
# =============================================================================
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=study_materials
MILVUS_URI="http://localhost:19530"
MILVUS_DENSE_FIELD=dense_vector
MILVUS_SPARSE_FIELD=sparse_vector

# =============================================================================
# RAG (检索增强生成) 检索配置
# 
# 检索模式说明:
# - hybrid: 混合检索（稠密向量 + 稀疏向量 + RRF 融合）
# - dense: 仅语义检索（稠密向量）
# - sparse: 仅关键词检索（稀疏向量）
#
# 主要参数说明:
# - RAG_TOP_K: 最终返回给 LLM 的文档片段数量
# - RAG_DENSE_TOP_K: 稠密向量检索的候选集大小
# - RAG_SPARSE_TOP_K: 稀疏向量检索的候选集大小
# - RAG_RRF_K: RRF (倒数秩融合) 算法的参数，控制排名融合平滑度
# - RAG_CHUNK_SIZE: 文档分块的大小（token 数）
# - RAG_CHUNK_OVERLAP: 相邻文档块之间的重叠大小，保证上下文连续性
# - RAG_EMBEDDING_MODEL: 使用的嵌入模型名称
#
# 高级功能开关:
# - RAG_ENABLE_METADATA_FILTER: 是否启用元数据过滤
# - RAG_ENABLE_QUERY_REWRITE: 是否启用查询重写以优化检索效果
# - RAG_ENABLE_MULTI_QUERY: 是否启用多查询生成，从不同角度检索
# - RAG_MULTI_QUERY_COUNT: 多查询模式下生成的查询数量
# - RAG_ENABLE_HYDE: 是否启用 HyDE (假设性文档嵌入) 技术
# - RAG_ENABLE_RERANK: 是否启用重排序以提升相关性
# - RAG_RERANK_METHOD: 重排序方法（none/cohere/bge-reranker 等）
# - RAG_ENABLE_CONTEXT_COMPRESSION: 是否启用上下文压缩以减少 token 消耗
# =============================================================================
RAG_RETRIEVAL_MODE=hybrid
RAG_TOP_K=5
RAG_DENSE_TOP_K=20
RAG_SPARSE_TOP_K=20
RAG_RRF_K=60
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=100
RAG_EMBEDDING_MODEL=BAAI/bge-m3
RAG_ENABLE_METADATA_FILTER=true
RAG_ENABLE_QUERY_REWRITE=true
RAG_ENABLE_MULTI_QUERY=true
RAG_MULTI_QUERY_COUNT=3
RAG_ENABLE_HYDE=false
RAG_ENABLE_RERANK=false
RAG_RERANK_METHOD=none
RAG_ENABLE_CONTEXT_COMPRESSION=false

# =============================================================================
# DeepSeek API 配置
# 用于调用 DeepSeek 大语言模型服务
# =============================================================================
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-v4-flash"

# =============================================================================
# LLM 调用模式开关
# true: 调用真实的 DeepSeek API
# false: 使用本地模拟的 LLM 响应（用于开发和测试）
# =============================================================================
USE_REAL_LLM=false

# =============================================================================
# RAG 存储模式开关
# true: 使用 PostgreSQL / Milvus 真实存储
# false: 使用本地内存检索，适合开发和测试
# =============================================================================
USE_REAL_RAG_STORE=false

# =============================================================================
# PostgreSQL 持久化开关
# true: 启用 PostgreSQL 数据持久化存储
# false: 禁用持久化，数据仅保存在内存中
# =============================================================================
USE_POSTGRES_PERSISTENCE=false
